# Copy this file to `.env` and fill in your keys. `.env` is gitignored — never commit it.

# ElevenLabs API key. Requires the Creator tier or above for 192 kbps output.
# Used by each episode's produce-episode.py and by _production/tools/fix-segment.py.
eleven-labs-api=

# Deepgram API key. Used by _production/tools/audio-qa.py for automated audio QA
# (transcribes the finished MP3 and diffs it against the script). Cheap; no ElevenLabs credits.
deepgram-api=
